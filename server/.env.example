# ==============================================================================
# NexAI Server Environment Configuration Template
# Copy this file to .env and supply actual values for production deployment
# ==============================================================================

# Server Runtime
PORT=5000
NODE_ENV=development

# Client URL (for CORS & Cookie matching)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas M0 Connection URI
# e.g., mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/nexai?retryWrites=true&w=majority
MONGODB_URI=

# JWT Session Authentication
JWT_SECRET=nexai-dev-jwt-secret-key-32-chars-minimum
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Credentials (Custom OAuth Flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Google Gemini AI (Backend-only, never leak to client)
# Uses Gemini 2.0 Flash (fast/chat/library) & Gemini 2.5 Pro (complex/docs)
GEMINI_API_KEY=

# Pinecone Vector Database (Starter Tier)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=nexai-library

# Web Push Notifications (VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
